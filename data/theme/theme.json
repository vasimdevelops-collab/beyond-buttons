      "hairline": "#E8E1D7",
      "hairlineGold": "rgba(176, 141, 87, 0.32)",
      "hairlineGoldStrong": "rgba(176, 141, 87, 0.48)"
    },
    "buttons": {
      "primaryBg": "#171717",
      "primaryText": "#F7F4EE",
      "primaryBorder": "#171717",
      "primaryHoverBorder": "#C9A46A",
      "secondaryBg": "#FFFCF8",
      "secondaryText": "#171717"
