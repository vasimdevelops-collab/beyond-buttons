      "hairlineGoldStrong": "rgba(212, 175, 55, 0.4)"
    },
    "buttons": {
      "primaryBg": "transparent",
      "primaryText": "#F5F5F5",
      "primaryBorder": "rgba(212, 175, 55, 0.4)",
      "primaryHoverBorder": "#F1D37B",
      "secondaryBg": "transparent",
      "secondaryText": "rgba(245, 245, 245, 0.82)"
    }
  },
  "light": {
    "background": {
      "bg": "#F7F4EE",
      "bgSecondary": "#FFFCF8",
      "surface": "#FFFCF8",
      "card": "#FFFCF8",
      "frame": "linear-gradient(155deg, #FFFCF8 0%, #F7F4EE 55%, #EFE8DC 100%)",
      "backdrop": "linear-gradient(180deg, #FFFCF8 0%, #F7F4EE 52%, #EFE8DC 100%)"
