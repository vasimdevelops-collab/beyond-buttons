{
  "version": 1,
  "defaultTheme": "dark",
  "storageKey": "bb-theme",
  "gold": {
    "dark": {
      "gold": "#D4AF37",
      "goldLight": "#F1D37B",
      "accent": "#C9A96E",
      "hoverGold": "#F1D37B"
    },
    "light": {
      "gold": "#B08D57",
      "goldLight": "#C9A46A",
      "accent": "#B08D57",
      "hoverGold": "#C9A46A"
    }
  },
  "dark": {
    "background": {
      "bg": "#090909",
      "bgSecondary": "#111111",
      "surface": "#111111",
      "card": "#181818",
      "frame": "linear-gradient(155deg, #0D0D0D 0%, #050505 55%, #020202 100%)",
      "backdrop": "linear-gradient(180deg, #050505 0%, #020202 55%, #000000 100%)"
    },
    "text": {
